<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="LastWave"
           Manufacturer="Clash-Projects"
           Version="$(var.Version)"
           UpgradeCode="E8B4F6A2-7C3D-4A1E-9F5B-2D6A8C4E1A3B"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LastWave" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="7B2A1E3C-4D5F-6A7B-8C9D-0E1F2A3B4C5D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="LastWave"
                  Description="LastWave Music Player"
                  Target="[INSTALLFOLDER]lastwave_desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\LastWave" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="LastWave" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
