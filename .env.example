# ==========================================
# LastWave Desktop Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env with real secrets.
# Variable names mirror LastWave-native (.env.example)
# ==========================================

# Lossless backend (clashflac-compatible REST) — Qobuz
LOSSLESS_BACKEND_URL=
LOSSLESS_API_KEY=

# Tidal HiFi-API (MPD decrypter). Used when Qobuz has no match.
BACKEND_B_URL=
BACKEND_B_KEY=

# Lyrics (LyricsPlus x-api-key)
LYRICS_API_KEY=

# Last.fm (defaults match LastWave-native BuildConfig fallbacks;
# override here only if you use your own Last.fm app credentials)
LASTFM_API_KEY=
LASTFM_API_SECRET=
